# ==============================================================================
# TicketlyCRM Backend - Supabase Environment Configuration
# ==============================================================================

# Supabase PostgreSQL Connection String
# Replace YOUR_PROJECT_REF and YOUR_PASSWORD with your Supabase credentials:
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require


# Optional Discrete Parameters:
# SUPABASE_DB_USER=postgres.YOUR_PROJECT_REF
# SUPABASE_DB_PASSWORD=YOUR_PASSWORD
# SUPABASE_DB_HOST=aws-0-us-east-1.pooler.supabase.com
# SUPABASE_DB_PORT=6543
# SUPABASE_DB_NAME=postgres

ENVIRONMENT=development

# Frontend origins allowed during local development.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: writable directory for uploaded ticket attachments.
# UPLOAD_DIR=backend/static/uploads
