{
  "name": "ticketly-crm",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend ci --include=dev && npm --prefix frontend run build",
    "install:frontend": "npm --prefix frontend install",
    "preview": "npm --prefix frontend run preview",
    "backend": "python -m uvicorn backend.main:app --host 0.0.0.0 --port 8000",
    "test:backend": "python backend/tests/test_api.py"
  }
}
