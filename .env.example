# ==============================================================================
# TicketlyCRM Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# SUPABASE POSTGRESQL DATABASE
# ------------------------------------------------------------------------------
# Option 1: Full Connection String (Recommended for Vercel & Supabase)
# Note: For serverless environments like Vercel, use Supabase's "Transaction Pooler"
# on port 6543 with sslmode=require to prevent connection pool exhaustion.
#
# Get this from: Supabase Dashboard -> Project Settings -> Database -> Connection string (URI) -> Transaction Pooler (port 6543)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Option 2: Discrete Supabase Parameters (Alternative if not using DATABASE_URL)
# SUPABASE_DB_USER=postgres.YOUR_PROJECT_REF
# SUPABASE_DB_PASSWORD=YOUR_STRONG_PASSWORD
# SUPABASE_DB_HOST=aws-0-us-east-1.pooler.supabase.com
# SUPABASE_DB_PORT=6543
# SUPABASE_DB_NAME=postgres

# ------------------------------------------------------------------------------
# APPLICATION SETTINGS
# ------------------------------------------------------------------------------
ENVIRONMENT=production

# Comma-separated browser origins allowed to call the local/API server.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend API URL
# Leave commented out on Vercel fullstack deployment; the frontend automatically
# uses relative '/api' on live deployments and http://localhost:8000/api locally.
# VITE_API_URL=https://your-app.vercel.app/api

# Optional: writable directory for uploaded ticket attachments. On Vercel this
# defaults to /tmp/ticketlycrm-uploads, which is ephemeral; use object storage
# for durable production attachments.
# UPLOAD_DIR=backend/static/uploads
